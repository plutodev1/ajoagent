# Agent wallet private key (the agent holds the pot and signs swaps + payouts).
# Use a FRESH wallet for this, never your main wallet.
AGENT_PRIVATE_KEY=0x...

# Your attribution tag from Loops House enrollment (lowercase a-z 0-9 _ , max 32 chars)
ATTRIBUTION_CODE=

# Optional: custom RPC (defaults to Forno)
CELO_RPC_URL=https://forno.celo.org

# Optional: Textile partner API key. Leave empty to use keyless wallet proof.
TEXTILE_API_KEY=

# 1 = print what would happen, send nothing
DRY_RUN=1
